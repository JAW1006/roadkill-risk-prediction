# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── Anthropic Claude API (정책 브리핑 생성 + RAG 챗봇 답변) ──
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 사용 모델 (Haiku 4.5: 200K 컨텍스트, $1 / $5 per MTok)
ANTHROPIC_MODEL=claude-haiku-4-5

# ── 공공데이터 API 키 (데이터 수집 단계에서 사용) ──────────────
# 공공데이터포털(data.go.kr) — 도로망 GIS, AADT 등
DATA_GO_KR_API_KEY=

# 기상청 날씨누리 / 기상자료개방포털 — 강수·안개·기온
KMA_API_KEY=

# 국립생태원 에코뱅크 — 로드킬 발생지점, 서식지·생태통로
ECOBANK_API_KEY=

# 도로교통공단 TAAS — 로드킬 사고 지점
TAAS_API_KEY=

# ── 로컬 경로 설정 (미지정 시 프로젝트 기본 경로 사용) ─────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# ── RAG 벡터 저장소 ──────────────────────────────────────────
CHROMA_PERSIST_DIR=chroma_db
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
